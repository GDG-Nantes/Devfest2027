---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTranslation } from '@/i18n/i18n';
import { getLocaleFromParams } from '@/i18n/i18n';
import i18nConfig from '@/i18n/i18nConfig';
import HomeJumbo from '@/components/react/HomeJumbo';
import InteractiveMap from '@/components/react/InteractiveMap';
import '@/styles/jumbo.scss';
import '@/styles/home.scss';
import { getUiSvgIcon } from '@/components/icons/flat-icons';

export function getStaticPaths() {
  return i18nConfig.locales.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromParams(Astro.params);
const t = await getTranslation(locale);
const tNumbers = await getTranslation(locale, 'pages.home.numbers');
const tTickets = await getTranslation(locale, 'pages.home.tickets');
const tPhotos = await getTranslation(locale, 'pages.home.photos');
const tMap = await getTranslation(locale, 'pages.attending.map');

// Ticketing
const ticketingUrl = 'https://www.billetweb.fr/billet-devfest-nantes-2027';
const ticketSaleOpening = '2026-10-16T13:00:00+02:00';

// Photo album
const photos = [
  { src: '/images/home/album/faucheuses.jpg', alt: '' },
  { src: '/images/home/album/equipe-amphi.jpg', alt: '' },
  { src: '/images/home/album/adrien.jpg', alt: '' },
  { src: '/images/home/album/annabelle-jef.jpg', alt: '' },
  { src: '/images/home/album/chef.jpg', alt: '' },
  { src: '/images/home/album/stand.jpg', alt: '' },
  { src: '/images/home/album/concert.jpg', alt: '' },
  { src: '/images/home/album/2000.jpg', alt: '' },
];
---

<BaseLayout locale={locale}>
  <!-- Jumbo -->
  <HomeJumbo client:load locale={locale} />

  <!-- Tickets -->
  <div id="tickets" class="section full-width tickets-section">
    <h2>{tTickets('name')}</h2>

    <div class="sale-banner" data-opening={ticketSaleOpening}>
      <p class="sale-label">{tTickets('sale-label')}</p>
      <div class="sale-date">
        <span class="sale-chip">
          <Fragment set:html={getUiSvgIcon('calendar')} />
          {tTickets('sale-day')}
        </span>
        <span class="sale-chip">
          <Fragment set:html={getUiSvgIcon('clock')} />
          {tTickets('sale-time')}
        </span>
      </div>

      <div class="countdown" aria-hidden="true">
        <div class="countdown-item"><span data-unit="days">--</span><small>{tTickets('countdown.days')}</small></div>
        <div class="countdown-item"><span data-unit="hours">--</span><small>{tTickets('countdown.hours')}</small></div>
        <div class="countdown-item"><span data-unit="minutes">--</span><small>{tTickets('countdown.minutes')}</small></div>
        <div class="countdown-item"><span data-unit="seconds">--</span><small>{tTickets('countdown.seconds')}</small></div>
      </div>
      <p class="sale-open">{tTickets('open')}</p>

      <p class="sale-description">{tTickets('description')}</p>
      <a
        href={ticketingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="sale-cta"
        data-umami-event="ticketing"
      >
        <Fragment set:html={getUiSvgIcon('ticket')} />
        {tTickets('cta')}
      </a>
    </div>

    <div class="tickets-grid">
      <a
        href={ticketingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ticket-wrapper"
        data-umami-event="ticketing-2days"
      >
        <div class="ticket active">
          <div class="ticket-header">{tTickets('2days')}</div>
          <div class="ticket-price">140 € <span class="ht">HT</span></div>
          <div class="ticket-info">
            <p>{tTickets('2days-detail')}</p>
          </div>
        </div>
      </a>
      <div class="ticket-wrapper">
        <div class="ticket disabled">
          <div class="ticket-header">{tTickets('1day')}</div>
          <div class="ticket-price coming-soon">{tTickets('coming-soon')}</div>
          <div class="ticket-info">
            <p>{tTickets('1day-detail')}</p>
          </div>
        </div>
      </div>
    </div>

    <p class="tickets-reduced">{tTickets('reduced-info')}</p>
  </div>

  <!-- What is DevFest -->
  <div class="section">
    <h1>{t('pages.home.what-is')}</h1>
    <p>{t('site.description')}</p>
    <p>{t('site.theme')}</p>

    <!-- Our Values Link -->
    <div class="our-values-link">
      <a href={`/${locale}/our-values`}>
        <Fragment set:html={getUiSvgIcon('accessibility')} />
        <p>{tNumbers('our-values')}</p>
      </a>
    </div>

    <!-- Numbers -->
    <h2>{tNumbers('title')}</h2>
    <div class="numbers-grid">
      <div class="number-item">
        <h2 class="no-leaf">{3500}</h2>
        <p>{tNumbers('attendees')}</p>
      </div>
      <div class="number-item">
        <h2 class="no-leaf">{2}</h2>
        <p>{tNumbers('days')}</p>
      </div>
      <div class="number-item">
        <h2 class="no-leaf">{71}</h2>
        <p>{tNumbers('sessions')}</p>
      </div>
      <div class="number-item">
        <h2 class="no-leaf">{4}</h2>
        <p>{tNumbers('tracks')}</p>
      </div>
      <div class="number-item">
        <h2 class="no-leaf">90+</h2>
        <p>{tNumbers('speakers')}</p>
      </div>
    </div>

    <!-- Exceptional Info -->
    <div id="exceptional-info" class="exceptional-info">
      <h2>{t('pages.home.exceptional.title')}</h2>
      <p>{t('pages.home.exceptional.description')}</p>
    </div>

    <!-- YouTube embed -->
    <div style="text-align: center;">
      <h2>AfterMovie 2025</h2>
      <div class="youtube-container">
        <iframe width="560" height="315" src="https://www.youtube.com/embed/LUsRAtZqeJk?si=7HljdJbJ40X0Sxhk"
                title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </div>
  </div>


  <!-- Map -->
  <InteractiveMap
    client:only="react"
    title={tMap('title')}
    description={tMap('description')}
    locale={locale}
  />

  <!-- Photos -->
  <div class="section full-width">
    <div class="photos-grid">
      <div class="photo-item high" style="grid-column: 1; grid-row: span 2;">
        <img src={photos[0].src} alt="" />
      </div>
      <div class="photo-item low" style="grid-column: span 2;">
        <img src={photos[1].src} alt="" />
      </div>
      <div class="photo-item low" style="grid-column: span 2;">
        <img src={photos[2].src} alt="" style="object-position: top;" />
      </div>
      <div class="photo-tile" style="grid-column: span 2;">
        <p>{tPhotos('p1')}</p>
        <p style="margin-top: 0;">{tPhotos('p2')}</p>
        <a
          href="https://photos.app.goo.gl/H1EqkeCNkjjYMxCCA"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
          data-umami-event="photos-2025"
        >
          {tPhotos('button')}
        </a>
      </div>
      <div class="photo-item high" style="grid-column: span 1; grid-row: span 2;">
        <img src={photos[3].src} alt="" />
      </div>
      <div class="photo-item square" style="grid-column: span 1;">
        <img src={photos[4].src} alt="" />
      </div>
      <div class="photo-item low" style="grid-column: span 2;">
        <img src={photos[7].src} alt="" />
      </div>
      <div class="photo-item square" style="grid-column: span 1;">
        <img src={photos[5].src} alt="" />
      </div>
      <div class="photo-item square no-mobile" style="grid-column: span 1;">
        <img src={photos[6].src} alt="" />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    justify-items: center;
    margin: 20px 0;
  }
  @media (max-width: 900px) {
    .numbers-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .numbers-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .number-item {
    text-align: center;
    min-width: 100px;
  }
  .number-item h2 {
    margin: 10px 0;
  }

  .youtube-container {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }
  .youtube-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  :global(.interactive-map-section) {
    position: relative;
    width: 100%;
    height: 500px;
  }
  :global(.interactive-map-section .leaflet-container) {
    width: 100%;
    height: 100%;
  }
  :global(.map-info-overlay) {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background-color: var(--primary);
    color: white;
    padding: 20px;
    max-width: 40vw;
    z-index: 1000;
  }
  @media (max-width: 600px) {
    :global(.interactive-map-section) {
      height: 450px;
    }
    :global(.map-info-overlay) {
      position: relative;
      bottom: auto;
      left: auto;
      max-width: 100%;
    }
  }


  .exceptional-info {
    background-color: var(--primary);
    color: white;
    border-radius: 12px;
    padding: 32px;
    margin: 40px 0;
    text-align: center;
    scroll-margin-top: 80px;
    border: 3px solid var(--secondary);
  }
  .exceptional-info h2 {
    margin-top: 0;
    color: white;
  }
  .exceptional-info p {
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
  }

  .photos-grid {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(3, 30vh);
    grid-auto-flow: dense;
  }
  @media (max-width: 600px) {
    .photos-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(5, 17vh);
    }
    .no-mobile { display: none; }
  }
  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-item.square img { aspect-ratio: 1 / 1; }
  .photo-item.low img { aspect-ratio: 16 / 9; }
  .photo-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.95rem;
    cursor: pointer;
    color: white;
  }
  .btn-secondary {
    background-color: var(--secondary);
  }
  .btn-secondary:hover { opacity: 0.9; }
  .btn-primary {
    background-color: var(--primary);
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .btn-primary:hover { background-color: #1a2d42; }
</style>

<script>
  const banner = document.querySelector<HTMLElement>('.sale-banner');
  if (banner?.dataset.opening) {
    const opening = new Date(banner.dataset.opening).getTime();
    const units = {
      days: banner.querySelector('[data-unit="days"]'),
      hours: banner.querySelector('[data-unit="hours"]'),
      minutes: banner.querySelector('[data-unit="minutes"]'),
      seconds: banner.querySelector('[data-unit="seconds"]'),
    };
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const diff = opening - Date.now();
      if (diff <= 0) {
        banner.classList.add('is-open');
        clearInterval(timer);
        return;
      }
      const s = Math.floor(diff / 1000);
      units.days!.textContent = pad(Math.floor(s / 86400));
      units.hours!.textContent = pad(Math.floor((s % 86400) / 3600));
      units.minutes!.textContent = pad(Math.floor((s % 3600) / 60));
      units.seconds!.textContent = pad(s % 60);
    };
    const timer = setInterval(tick, 1000);
    tick();
  }
</script>
